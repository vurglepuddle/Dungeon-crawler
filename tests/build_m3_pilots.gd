extends "res://tests/build_m2_pilots.gd"
const Codec=preload("res://scripts/persistence/state_codec.gd")
## Generates real taps from ordinary commands; no sim action hooks in playback.
func emit(action: Dictionary) -> void:
	if action.type=="pickup":
		add("tapnamed hot_item_"+action.item_id)
		var state: Dictionary=replay.snapshot()
		var pile: Array=replay.reachable_items().filter(func(id): return state.items[id].pos==state.items[action.item_id].pos)
		if pile.size()>1: add("wait 3"); add("tapnamed loot_"+action.item_id)
		add("waitidle"); assert(replay.apply(action).accepted); return
	if action.type=="return_item":
		add("tapnamed hot_porter"); add("wait 4"); add("shot 20_porter_offer")
		add("tapnamed porter_close"); add("wait 3")
		var state: Dictionary=replay.snapshot()
		add("tapnamed pack%d"%state.pack.find(action.item_id)); add("wait 3")
		add("shot 21_clapper_return_target"); add("tapnamed hot_front"); add("waitidle")
		assert(replay.apply(action).accepted)
		add("shot 22_porter_restored"); return
	if action.type=="ride":
		var fixtures: Array=replay.fixture_actions().filter(func(f): return f.action.type!="return_item")
		var index: int=-1
		for i in range(fixtures.size()):
			if fixtures[i].action.target_id==action.target_id: index=i; break
		assert(index>=0)
		add("shot 25_lift_before_ride")
		add("tapnamed "+("hot_front" if index==0 else "hot_"+action.target_id)); add("waitidle")
		assert(replay.apply(action).accepted)
		add("shot 26_lift_home"); return
	super.emit(action)

func _begin() -> void:
	replay=Sim.new("BELL42")
	lines=["# Generated by tests/build_m3_pilots.gd; use an isolated --save-path.","wait 4","call new_run BELL42","wait 3","waitidle"]

func _initialize() -> void:
	for policy in ["return","keep"]:
		_begin()
		var proof: Dictionary=W.build("BELL42",2,false,policy)
		assert(proof.ok)
		add("shot 16_m3_entry")
		var previous_floor:=1
		var save_a: Array=[]
		var saved: Dictionary={}
		for action in proof.actions:
			emit(action)
			if action.type=="return_item":
				saved=replay.snapshot(); save_a=lines.duplicate()
				save_a.append_array(["call assert porter {\"present\":true,\"restored\":true}","call assert save_ok true","call assert hash "+replay.state_hash(),"call state","shot 23_restored_before_close","close"])
			if replay.snapshot().floor!=previous_floor:
				add("shot m3_floor_%d_turn_%d"%[replay.snapshot().floor,replay.snapshot().turn]); previous_floor=replay.snapshot().floor
			if action.type=="pickup" and action.item_id=="f2_seal":
				add("shot 24_dawn_seal")
				add("tapnamed map"); add("wait 4"); add("shot 29_seal_site_map")
				add("tapnamed map_close"); add("waitidle")
		add("call assert status won"); add("call assert hp 6")
		add("call assert turn %d"%replay.snapshot().turn); add("call assert hash "+replay.state_hash())
		add("call state"); add("shot 27_m3_home_"+policy); add("quit")
		write_file("res://tests/pilot/m3_"+policy+".txt",lines)
		if policy=="return":
			write_file("res://tests/pilot/m3_save_a.txt",save_a)
			var resume: Array=["# Fresh process after m3_save_a, same --save-path.","wait 4","call assert status title","tapnamed continue","waitidle"]
			resume.append_array(["call assert porter {\"present\":true,\"restored\":true}","call assert turn %d"%saved.turn,"call assert hash "+Codec.canonical(saved).sha256_text(),"call assert save_ok true","call state","shot 28_restored_continued","quit"])
			write_file("res://tests/pilot/m3_save_b.txt",resume)
		print("M3 pilot ",policy,": ",replay.snapshot().turn," turns / ",proof.actions.size()," actions")
	_room()
	quit()

func _room() -> void:
	_begin()
	emit({"type":"move","step":"fwd"})
	for direction in ["north","east","south","west"]:
		add("shot room_"+direction)
		emit({"type":"turn","delta":1})
	add("call assert turn 1"); add("call assert hp 6")
	add("tapnamed map"); add("wait 4"); add("shot 17_seen_map")
	add("tapnamed map_close"); add("waitidle")
	add("call assert hash "+replay.state_hash()); add("quit")
	write_file("res://tests/pilot/m3_room.txt",lines)
